# Copy to .env.local and fill in.
# Hidden admin path: pick something hard to guess, e.g. /ops-3f9a1c7e2b4d
ADMIN_PATH=/ops-change-me
ADMIN_PASSWORD=change-me
# 32+ random characters
AUTH_SECRET=
# Postgres connection string, e.g. from Neon
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# The site's public address. Passkeys are tied to it, e.g. https://anchorbank.com (leave unset for localhost)
APP_ORIGIN=
# Push notifications. Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services: mailto:you@yourbank.com or https://yourbank.com
VAPID_SUBJECT=
# Email via Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Sender on a domain you've verified in Resend, e.g. Anchor Bank <no-reply@yourbank.com>
EMAIL_FROM=
# Optional: where staff alerts go (new deposits and withdrawals to review)
STAFF_EMAIL=
